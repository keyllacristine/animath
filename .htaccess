# Desativa a listagem pública de pastas por segurança
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Define a pasta base do projeto
    RewriteBase /animath/

    # Redireciona tudo para public/
    RewriteCond %{REQUEST_URI} !^/animath/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>